+// ---- EXPAND slices ---------------------------------------------------------------
+
+void Gpu3D::wide_add(const Gpu3D& src, Vertex* v, int n, bool facing) {
+  // The polygon state the game set for it.
+  cur_polygon_attr_ = src.cur_polygon_attr_;
+  texparam_ = src.texparam_;
+  texpal_ = src.texpal_;
+  viewport_ = src.viewport_;
+  zero_dot_w_limit_ = src.zero_dot_w_limit_;
+  flush_attr_ = src.flush_attr_;
+  poly_mode_ = 0;   // no strip sharing: each polygon stands alone here
+  last_strip_poly_ = nullptr;
+  unsigned all = 0x3F, any = 0;
+  for (int i = 0; i < n; ++i) { v[i].oc = outcode(v[i].pos); all &= v[i].oc; any |= v[i].oc; }
+  if (all) return;
+  const Vertex* ptr[4] = {&v[0], &v[1], &v[2], n > 3 ? &v[3] : &v[0]};
+  if (any == 0) emit_polygon_unclipped(ptr, n, 0, nullptr, facing);
+  else emit_polygon_clipped(ptr, n, 0, nullptr, 0, facing);
+}
+
+void Gpu3D::wide_swap(const Gpu3D& src) {
+  flush_attr_ = src.flush_attr_;
+  // Opaque first, then translucent, sorted as finalise_list does.
+  u32 io = 0, it = num_opaque_;
+  const Polygon* pr = cur_pram();
+  auto& rp = render_polys_[bank_];
+  for (u32 i = 0; i < num_polygons_; ++i) { const Polygon* p = &pr[i]; if (p->translucent) rp[it++] = p; else rp[io++] = p; }
+  std::stable_sort(rp.begin(), rp.begin() + ((flush_attr_ & 1) ? num_opaque_ : num_polygons_),
+                   [](const Polygon* a, const Polygon* b) { return a->sort_key < b->sort_key; });
+  render_count_[bank_] = num_polygons_;
+  wide_pending_ = bank_;
+  bank_ ^= 1;   // two banks: one built while the other waits to be drawn
+  num_polygons_ = num_vertices_ = num_opaque_ = 0;
+}
+
+void Gpu3D::wide_render(const Gpu3D& src) {
+  if (wide_pending_ == 0xFFFF) return;
+  renderer_.sync_all();
+  raster_bank_ = wide_pending_;
+  wide_pending_ = 0xFFFF;
+  rstate_ = src.rstate_;
+  render_identical_ = false;
+  renderer_.render(*this);
+  renderer_.sync_all();
+  wide_frame_ = renderer_.frame_ref(false);
+  for (u32 y = 0; y < 192; ++y) renderer_.sync_line(wide_frame_, static_cast<s32>(y));
+}
+
 void Gpu3D::set_render_xpos(u16 value, u16 mask) {
   if (!render_on_.load(std::memory_order_relaxed)) return;
   render_xpos_ = (render_xpos_ & ~mask) | (value & mask & 0x1FF);
